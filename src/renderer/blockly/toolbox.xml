<xml xmlns="https://developers.google.com/blockly/xml" id="toolbox" style="display: none">
  <category name="Controle" categorystyle="control_category">
    <block type="delay">
      <value name="milliseconds">
        <shadow type="integer">
          <field name="value">1000</field>
        </shadow>
      </value>
    </block>
    <sep gap="8"></sep>
    <block type="controls_if"></block>
    <sep gap="8"></sep>
    <block type="repeat_times">
      <value name="times">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <sep gap="8"></sep>
    <block type="repeat_while">
      <value name="condition">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
    </block>
    <sep gap="8"></sep>
    <block type="repeat_until">
      <value name="condition">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
    </block>
  </category>
  <category name="Entrada e saída" categorystyle="io_category">
    <block type="set_digital_pin">
      <value name="pin">
        <shadow type="digital_output">
          <field name="digital_output">SD0</field>
        </shadow>
      </value>
      <value name="state">
        <shadow type="state">
          <field name="state">LOW</field>
        </shadow>
      </value>
    </block>
    <sep gap="8"></sep>
    <block type="analog_pin">
      <value name="pin">
        <shadow type="analog_input">
          <field name="analog_input">EA0</field>
        </shadow>
      </value>
    </block>
    <sep gap="8"></sep>
    <block type="digital_pin">
      <value name="pin">
        <shadow type="digital_input">
          <field name="digital_input">ED0</field>
        </shadow>
      </value>
    </block>
    <sep gap="8"></sep>
    <block type="analog_input">
      <field name="analog_input">EA0</field>
    </block>
    <sep gap="8"></sep>
    <block type="digital_input">
      <field name="digital_input">ED0</field>
    </block>
    <sep gap="8"></sep>
    <block type="digital_output">
      <field name="digital_output">SD0</field>
    </block>
  </category>
  <category name="Variáveis e constantes" categorystyle="variable_category" custom="VARIABLES"></category>
  <category name="Operações" categorystyle="operation_category">
    <block type="binary_operation">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">add</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="binary_operation">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">sub</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="binary_operation">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">and</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="binary_operation">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">or</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="binary_operation">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">xor</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="logic_operation">
      <value name="operand1">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
      <field name="operation">and2</field>
      <value name="operand2">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
    </block>
    <block type="logic_operation">
      <value name="operand1">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
      <field name="operation">or2</field>
      <value name="operand2">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
    </block>
    <block type="logic_operation">
      <value name="operand1">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
      <field name="operation">xor2</field>
      <value name="operand2">
        <shadow type="boolean">
          <field name="value">FALSE</field>
        </shadow>
      </value>
    </block>
  </category>
  <category name="Comparações" categorystyle="comparison_category">
    <block type="comparison">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">eq</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="comparison">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">ne</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="comparison">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">lt</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="comparison">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">le</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="comparison">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">gt</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
    <block type="comparison">
      <value name="operand1">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
      <field name="operation">ge</field>
      <value name="operand2">
        <shadow type="integer">
          <field name="value">0</field>
        </shadow>
      </value>
    </block>
  </category>
</xml>
