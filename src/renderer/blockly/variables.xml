<variables>
    <buttons>
        <button text="Nova variável" callbackKey="newVariablePressed"></button>
        <button text="Nova constante" callbackKey="newConstantPressed"></button>
    </buttons>
    <constants>
        <label text="PREDEFINIDAS" web-class="subcategory"></label>
        <sep gap="8"></sep>
        <block type="integer">
            <field name="value">0</field>
        </block>
        <sep gap="8"></sep>
        <block type="boolean">
            <field name="value">TRUE</field>
        </block>
        <sep gap="8"></sep>
        <block type="boolean">
            <field name="value">FALSE</field>
        </block>
        <sep gap="8"></sep>
        <block type="state">
            <field name="state">HIGH</field>
        </block>
        <sep gap="8"></sep>
        <block type="state">
            <field name="state">LOW</field>
        </block>
    </constants>
    <getters>
        <block type="variables_get_integer">
            <field name="variable"></field>
        </block>
    </getters>
    <setters>
        <block type="variables_set_integer">
            <field name="variable" variabletype="u16"></field>
            <value name="value">
                <shadow type="integer">
                    <field name="value">0</field>
                </shadow>
            </value>
        </block>
        <block type="constant_define_integer">
            <field name="constant" variabletype="u16c"></field>
            <value name="value">
                <shadow type="integer">
                    <field name="value">0</field>
                </shadow>
            </value>
        </block>
    </setters>
</variables>
